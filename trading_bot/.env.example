# Скопируйте в .env и заполните. Файл .env никогда не попадает в git.

# Ключ Claude: https://platform.claude.com -> API Keys
ANTHROPIC_API_KEY=

# Токен T-Invest API: приложение Т-Инвестиций -> Настройки -> Токены T-Invest API
TINVEST_TOKEN=
# Номер счёта (нужен для реальной торговли, если счетов несколько)
TINVEST_ACCOUNT_ID=
